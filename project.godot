camera_move_down={
"deadzone": 0.2,
"events": [InputEventKey({
"physical_keycode": 83,
"keycode": 0,
"pressed": false,
"echo": false,
"script_insert": false,
"cmd_or_ctrl_autorepeat": false,
"shift": false,
"alt": false
}), InputEventKey({
