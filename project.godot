ui_pause={
"deadzone": 0.2,
"events": [InputEventKey({
"physical_keycode": 4193399,
"keycode": 0,
"pressed": false,
"echo": false,
"script_insert": false,
"cmd_or_ctrl_autorepeat": false,
"shift": false,
"alt": false
}), InputEventKey({
