"pressed": false,
"echo": false,
"script_insert": false,
"cmd_or_ctrl_autorepeat": false,
"shift": false,
"alt": false
})]
}

[rendering]

renderer/rendering_method="forward_plus"
textures/canvas_textures/default_texture_filter=1
anti_aliasing/quality/msaa_3d=1
