; Engine configuration file.
; It's best edited using the editor UI and not directly,
; but smart editing of this file should work too.

[application]

config/name="CiviliSim"
config/version="0.1.0"
config/description="Colony/Civilization sim 2D con agentes autónomos"
run/main_scene="res://scenes/main/main.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")

[application/config]

icon="res://icon.svg"

[autoload]

ColonyManager="*res://scripts/systems/colony_manager.gd"
ResourceManager="*res://scripts/systems/resource_manager.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[i18n]

locale/translations_dir="res://translations/"

[input]

camera_zoom_in={
"deadzone": 0.2,
"events": [InputEventMouseButton({
"button_index": 5,
"ctrl_pressed": false,
"double_click": false,
"echo": false,
"global_position": -1,
"shift_pressed": false,
"timestamp": 0,
"button_mask": 0,
"position": -1
})]
}
camera_zoom_out={
"deadzone": 0.2,
"events": [InputEventMouseButton({
"button_index": 4,
"ctrl_pressed": false,
"double_click": false,
"echo": false,
"global_position": -1,
"shift_pressed": false,
"timestamp": 0,
"button_mask": 0,
"position": -1
})]
}
camera_move_left={
"deadzone": 0.2,
"events": [InputEventKey({
"physical_keycode": 65,
"keycode": 0,
"pressed": false,
"echo": false,
"script_insert": false,
"cmd_or_ctrl_autorepeat": false,
"shift": false,
"alt": false
}), InputEventKey({
"physical_keycode": 16908261,
"keycode": 0,
"pressed": false,
"echo": false,
"script_insert": false,
"cmd_or_ctrl_autorepeat": false,
"shift": false,
"alt": false
})]
}
camera_move_right={
"deadzone": 0.2,
"events": [InputEventKey({
