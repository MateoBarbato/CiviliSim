"script_insert": false,
"cmd_or_ctrl_autorepeat": false,
"shift": false,
"alt": false
})]
}
camera_move_up={
"deadzone": 0.2,
"events": [InputEventKey({
"physical_keycode": 87,
"keycode": 0,
"pressed": false,
"echo": false,
"script_insert": false,
"cmd_or_ctrl_autorepeat": false,
"shift": false,
"alt": false
}), InputEventKey({
"physical_keycode": 16908260,
"keycode": 0,
"pressed": false,
"echo": false,
"script_insert": false,
"cmd_or_ctrl_autorepeat": false,
"shift": false,
"alt": false
})]
